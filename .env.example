# ---------------------------------------------------------------
# Courtix environment variables
# Copy to `.env.local` and fill in. Nothing here is required for
# the local JSON-store demo to run — every value has a safe default.
# ---------------------------------------------------------------

# Public site URL, used for absolute links in emails / metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which storage adapter the waitlist + bookings use.
#   json     -> data/*.json on disk (default, zero config)
#   firebase -> Firestore (see BOOKING_INTEGRATION_PLAN.md, Phase 2)
#   postgres -> Prisma/Postgres (see BOOKING_INTEGRATION_PLAN.md, Phase 2)
STORAGE_DRIVER=json

# --- Firebase (only when STORAGE_DRIVER=firebase) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Postgres (only when STORAGE_DRIVER=postgres) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/courtix

# --- Payments (Phase 3) ---
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
